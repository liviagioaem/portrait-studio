# Opcional, caso o modelo exija autenticação
HF_TOKEN=

# Modelo base para image-to-image (gratuito/open-source)
IMG2IMG_MODEL_ID=runwayml/stable-diffusion-v1-5
IMG2IMG_RESOLUTION=768

# Modelo para inpainting/outpainting
INPAINT_MODEL_ID=runwayml/stable-diffusion-inpainting
INPAINT_RESOLUTION=512

# Render: habilite para reduzir uso de VRAM (mais lento)
LOW_VRAM=0

# Cache de modelos (recomendado no Render com disco persistente)
HF_HOME=/opt/render/project/.cache/huggingface
TRANSFORMERS_CACHE=/opt/render/project/.cache/huggingface

# CPU funciona para testes, mas e lenta. Em producao prefira GPU.
DEVICE=cuda
